   "seed": 1129146504,
   "version": 541,
   "versionNonce": 1871432328,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792847331738,
   "created": 1792847273559,
   "link": null,
   "locked": false,
   "text": "A working Icicle Kit localizer with:\n- at least 20 pose updates per second and a measured worst-case latency;\n- under 5 W of compute power, benchmarked in joules per update against a GPU\n  running the same algorithm;\n- median error within 0.20 m and 5°;\n- bit-exact agreement with a Python fixed-point reference model.",
   "fontSize": 20,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A working Icicle Kit localizer with:\n- at least 20 pose updates per second and a measured worst-case latency;\n- under 5 W of compute power, benchmarked in joules per update against a GPU\n  running the same algorithm;\n- median error within 0.20 m and 5°;\n- bit-exact agreement with a Python fixed-point reference model.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
