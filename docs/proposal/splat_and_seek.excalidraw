  {
   "id": "vl-3HL63IvzIb5gRNvUa0",
   "type": "text",
   "x": 1080,
   "y": -1008.6754264527079,
   "width": 750.5999755859375,
   "height": 225,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "#96f2d7",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b2u",
   "roundness": null,
   "seed": 470925960,
   "version": 606,
   "versionNonce": 1264931924,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792905592529,
   "created": 1792847451351,
   "link": null,
   "locked": false,
   "text": "Existing Gaussian Splatting accelerators such as GSCore and Neo are ASIC\ndesigns built to draw images, and the closest FPGA work, LENS (2026), still\nsorts on the CPU. Loc-NeRF showed that a particle filter with a neural map\ncan localize a real robot, but only at one or two updates per second on a\nlaptop GPU. Splat-and-Seek turns rendering into a measuring tool: the\nGaussians are sorted once by depth and streamed to parallel lanes, so all\n300 guesses share a single sort, and a ground-robot shortcut trims the\nprojection maths. As far as we know, it is the first Gaussian Splatting\nlocalizer built in PolarFire fabric.",
   "fontSize": 20,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Existing Gaussian Splatting accelerators such as GSCore and Neo are ASIC\ndesigns built to draw images, and the closest FPGA work, LENS (2026), still\nsorts on the CPU. Loc-NeRF showed that a particle filter with a neural map\ncan localize a real robot, but only at one or two updates per second on a\nlaptop GPU. Splat-and-Seek turns rendering into a measuring tool: the\nGaussians are sorted once by depth and streamed to parallel lanes, so all\n300 guesses share a single sort, and a ground-robot shortcut trims the\nprojection maths. As far as we know, it is the first Gaussian Splatting\nlocalizer built in PolarFire fabric.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "RDxVx23N-CKmKOX_gc6mR",
   "type": "text",
   "x": 1080,
   "y": -753.6754264527079,
   "width": 243,
   "height": 32,
   "angle": 0,
   "strokeColor": "#3b82f6",
   "backgroundColor": "#96f2d7",
   "fillStyle": "solid",
