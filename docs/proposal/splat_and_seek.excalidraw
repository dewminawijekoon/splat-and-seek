   "isDeleted": false,
   "boundElements": [],
   "updated": 1792847593403,
   "created": 1792847466870,
   "link": null,
   "locked": false,
   "text": "What sets it apart",
   "fontSize": 26,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "What sets it apart",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "ow2DRKs0mxIRYJqYrxJfJ",
   "type": "text",
   "x": 1080,
   "y": -711.6754264527079,
   "width": 880,
   "height": 125,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "#96f2d7",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b2w",
   "roundness": null,
   "seed": 1581559544,
   "version": 696,
   "versionNonce": 49582216,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792847595514,
   "created": 1792847479452,
   "link": null,
   "locked": false,
   "text": "- Camera-only mapping: even a basic camera drone can survey a site.\n- The map doubles as a visual inspection record.\n- Few-watt compute with a predictable, bounded delay.\n- No cloud or radio link once deployed; lidar can plug in later through the\n  same interface.",
   "fontSize": 20,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "- Camera-only mapping: even a basic camera drone can survey a site.\n- The map doubles as a visual inspection record.\n- Few-watt compute with a predictable, bounded delay.\n- No cloud or radio link once deployed; lidar can plug in later through the\n  same interface.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "wEgwjcUrkhrc4Wya8-5FP",
   "type": "text",
   "x": 1080,
   "y": -556.6754264527079,
   "width": 81,
   "height": 32,
   "angle": 0,
   "strokeColor": "#3b82f6",
   "backgroundColor": "#96f2d7",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
