   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "34BBtKAU88tElZCRzPALC",
   "type": "text",
   "x": 0,
   "y": -1008.6754264527079,
   "width": 749.3499755859375,
   "height": 175,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "#96f2d7",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b2j",
   "roundness": null,
   "seed": 1490175211,
   "version": 231,
   "versionNonce": 613017044,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792905427374,
   "created": 1792846976955,
   "link": null,
   "locked": false,
   "text": "Inspection robots in nuclear plants, mines and other GPS-denied sites must\nlocalize themselves without a reliable radio link, under tight power and\nradiation budgets. At Fukushima Daiichi in 2017, an inspection robot reached\nits radiation dose limit in about two hours, so every minute spent\nlocalizing shortens the inspection. Current solutions rely on power-hungry\nGPUs running visual SLAM, or on lidar maps that carry no visual record for\nthe operator.",
   "fontSize": 20,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Inspection robots in nuclear plants, mines and other GPS-denied sites must\nlocalize themselves without a reliable radio link, under tight power and\nradiation budgets. At Fukushima Daiichi in 2017, an inspection robot reached\nits radiation dose limit in about two hours, so every minute spent\nlocalizing shortens the inspection. Current solutions rely on power-hungry\nGPUs running visual SLAM, or on lidar maps that carry no visual record for\nthe operator.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "hzO-Bp1YL__IZDT-wo9Nz",
   "type": "text",
   "x": 0,
   "y": -803.6754264527079,
   "width": 108,
   "height": 32,
   "angle": 0,
   "strokeColor": "#3b82f6",
   "backgroundColor": "#96f2d7",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b2k",
