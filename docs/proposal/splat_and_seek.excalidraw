   "isDeleted": false,
   "boundElements": [],
   "updated": 1792847598075,
   "created": 1792847494265,
   "link": null,
   "locked": false,
   "text": "Impact",
   "fontSize": 26,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Impact",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "awX-w83ybBCYD4-AWxbps",
   "type": "text",
   "x": 1080,
   "y": -514.6754264527079,
   "width": 880,
   "height": 125,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "#96f2d7",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b2y",
   "roundness": null,
   "seed": 947053304,
   "version": 815,
   "versionNonce": 1112217736,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792847600921,
   "created": 1792847504849,
   "link": null,
   "locked": false,
   "text": "In nuclear decommissioning, a robot that knows where it is can drive\nstraight to its target and spend its radiation budget on inspection instead\nof searching. The UK expects its civil nuclear clean-up to cost about £115\nbillion over 100 years, and mine re-entry after seismic events has the same\nneed.",
   "fontSize": 20,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "In nuclear decommissioning, a robot that knows where it is can drive\nstraight to its target and spend its radiation budget on inspection instead\nof searching. The UK expects its civil nuclear clean-up to cost about £115\nbillion over 100 years, and mine re-entry after seismic events has the same\nneed.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "VKhofmxcAPdIfrtkjAVcy",
   "type": "text",
   "x": 1080,
   "y": -359.67542645270794,
   "width": 149,
   "height": 32,
   "angle": 0,
   "strokeColor": "#3b82f6",
   "backgroundColor": "#96f2d7",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b2z",
   "roundness": null,
   "seed": 1596122360,
   "version": 562,
   "versionNonce": 851207304,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792847604726,
   "created": 1792847524152,
   "link": null,
   "locked": false,
   "text": "Scalability",
   "fontSize": 26,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Scalability",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "0xCV6IfszQ8EO3ZK_Odvl",
   "type": "text",
   "x": 1080,
   "y": -317.67542645270794,
   "width": 880,
   "height": 100,
   "angle": 0,
   "strokeColor": "#374151",
   "backgroundColor": "#96f2d7",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "b30",
   "roundness": null,
   "seed": 919264904,
   "version": 862,
   "versionNonce": 841635720,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1792847607094,
   "created": 1792847533190,
   "link": null,
   "locked": false,
   "text": "The design targets the whole PolarFire SoC family: a cheaper MPFS095T\nversion for volume, and Microchip's radiation-tolerant RT PolarFire SoC for\nharsher places, including planetary rovers, where Perseverance already used\nan FPGA for map-based visual navigation.",
   "fontSize": 20,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The design targets the whole PolarFire SoC family: a cheaper MPFS095T\nversion for volume, and Microchip's radiation-tolerant RT PolarFire SoC for\nharsher places, including planetary rovers, where Perseverance already used\nan FPGA for map-based visual navigation.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
